---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nosotros | LOBIALab">
    <div class="relative bg-brand-surface pt-40 pb-20 overflow-hidden -mt-20 font-sans">
        <div class="absolute inset-0 z-0">
            <img
                src="/images/via_seca.png"
                alt="Fondo Minares"
                class="w-full h-full object-cover opacity-50 mix-blend-luminosity transform scale-105"
            />
            <div
                class="absolute inset-0 bg-gradient-to-r from-brand-surface via-brand-surface/80 to-transparent"
            >
            </div>
            <div class="absolute inset-0 bg-brand-surface/40"></div>
        </div>

        <div
            class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10"
        >
            <div
                class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 mb-6 backdrop-blur-sm"
            >
                <div
                    class="w-1.5 h-1.5 rounded-full bg-brand-primary animate-pulse"
                >
                </div>
                <span
                    class="font-sans text-white font-bold uppercase tracking-[0.2em] text-[10px]"
                    >Excelencia y Precisión</span
                >
            </div>
            <h1
                class="fuente-titulos text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl uppercase"
            >
                Nosotros
            </h1>
            <p
                class="font-sans mt-4 max-w-2xl mx-auto text-lg text-gray-300 font-medium leading-relaxed"
            >
                Comprometidos con la excelencia e innovación.
            </p>
        </div>
    </div>

    <main class="bg-white font-sans">
        <section class="relative bg-white overflow-hidden py-12 sm:py-24">
            <div
                class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24"
            >
                <div class="flex flex-col lg:flex-row items-center gap-12">
                    <div class="w-full lg:w-1/2">
                        <div
                            class="relative rounded-2xl overflow-hidden shadow-2xl group"
                        >
                            <div
                                class="absolute inset-0 bg-brand-primary/20 group-hover:bg-transparent transition-colors duration-500 z-10"
                            >
                            </div>
                            <img
                                src="/images/nosotros1.jpeg"
                                alt="Lobia"
                                class="w-full h-80 lg:h-[28rem] object-cover transform transition-transform duration-700 group-hover:scale-105"
                            />
                        </div>
                    </div>

                    <div class="w-full lg:w-1/2 space-y-6">
                        <div class="flex items-center space-x-4">
                            <div
                                class="p-3 bg-brand-primary rounded-lg text-white shadow-lg"
                            >
                                <svg
                                    class="h-8 w-8"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </div>
                            <h3 class="fuente-titulos text-3xl font-bold text-gray-900">
                                Sobre LOBIA
                            </h3>
                        </div>

                        <p
                            class="font-sans text-lg text-gray-600 leading-relaxed text-left"
                        >
                            LOBIA es un sistema diseñado para que los negocios
                            usen la tecnología como parte de sus operaciones
                            diarias.
                        </p>
                        <p
                            class="font-sans text-lg text-gray-600 leading-relaxed text-left"
                        >
                            LOBIA te permite gestionar citas, clientes,
                            negocios, sucursales, servicios; también puedes
                            asignar personal administrativo y personal operativo
                            a sus respectivas tareas para asegurar una correcta
                            trazabilidad del negocio.
                        </p>

                        <p
                            class="font-sans text-lg text-gray-600 leading-relaxed text-left"
                        >
                            Y además puedes ver tus ventas, manejar el
                            calendario de citas TODO desde un mismo lugar.
                        </p>
                    </div>
                </div>

                <div>
                    <div class="text-center mb-12">
                        <h2
                            class="fuente-titulos text-3xl font-extrabold text-gray-900 sm:text-4xl"
                        >
                            Filosofía Empresarial
                        </h2>
                        <div
                            class="mt-4 w-24 h-1 bg-brand-primary mx-auto rounded-full"
                        >
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
                        <div
                            class="bg-gray-50 p-6 md:p-8 rounded-2xl border-t-4 border-brand-primary shadow-lg hover:shadow-xl transition-shadow duration-300"
                        >
                            <div
                                class="w-12 h-12 md:w-14 md:h-14 bg-brand-primary rounded-lg text-white flex items-center justify-center mb-4 md:mb-6 shadow-md"
                            >
                                <svg
                                    class="w-6 h-6 md:w-8 md:h-8"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                    ></path></svg
                                >
                            </div>
                            <h3
                                class="fuente-titulos text-xl md:text-2xl font-bold text-gray-900 mb-3 md:mb-4"
                            >
                                Visión
                            </h3>
                            <p
                                class="font-sans text-sm md:text-base text-gray-600 leading-relaxed text-left"
                            >
                                Ser la infraestructura digital estándar para el
                                crecimiento de las empresas que ofrecen
                                servicios, permitiendo a los negocios escalar
                                sus operaciones y sucursales.
                            </p>
                        </div>

                        <div
                            class="bg-gray-50 p-6 md:p-8 rounded-2xl border-t-4 border-brand-primary shadow-lg hover:shadow-xl transition-shadow duration-300"
                        >
                            <div
                                class="w-12 h-12 md:w-14 md:h-14 bg-brand-primary rounded-lg text-white flex items-center justify-center mb-4 md:mb-6 shadow-md"
                            >
                                <svg
                                    class="w-6 h-6 md:w-8 md:h-8"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M13 10V3L4 14h7v7l9-11h-7z"
                                    ></path></svg
                                >
                            </div>
                            <h3
                                class="fuente-titulos text-xl md:text-2xl font-bold text-gray-900 mb-3 md:mb-4"
                            >
                                Misión
                            </h3>
                            <p
                                class="font-sans text-sm md:text-base text-gray-600 leading-relaxed text-justify"
                            >
                                Nuestra misión es optimizar las operaciones de
                                nuestros clientes y darles el control de su
                                negocio aplicando la ingeniería de software.
                            </p>
                        </div>

                        <div
                            class="bg-gray-50 p-6 md:p-8 rounded-2xl border-t-4 border-brand-primary shadow-lg hover:shadow-xl transition-shadow duration-300"
                        >
                            <div
                                class="w-12 h-12 md:w-14 md:h-14 bg-brand-primary rounded-lg text-white flex items-center justify-center mb-4 md:mb-6 shadow-md"
                            >
                                <svg
                                    class="w-6 h-6 md:w-8 md:h-8"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path></svg
                                >
                            </div>
                            <h3
                                class="fuente-titulos text-xl md:text-2xl font-bold text-gray-900 mb-3 md:mb-4"
                            >
                                Valores
                            </h3>
                            <ul
                                class="font-sans text-sm md:text-base text-gray-600 leading-relaxed text-left"
                            >
                                {
                                    [
                                        "Confianza",
                                        "Responsabilidad",
                                        "Honestidad",
                                        "Innovación",
                                    ].map((value) => (
                                        <li class="flex items-center text-gray-600 font-sans">
                                            <svg
                                                class="w-5 h-5 text-brand-primary mr-3"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M5 13l4 4L19 7"
                                                />
                                            </svg>
                                            <span class="font-sans font-medium">
                                                {value}
                                            </span>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>