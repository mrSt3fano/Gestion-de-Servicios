---
/**
 * Página de Contacto | LOBIA
 * Diseño usando tipografías y colores del sistema global.
 */
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto | LOBIA">
    <!-- Hero Header -->
    <div class="relative bg-brand-surface pt-40 pb-20 overflow-hidden -mt-20">
        <div class="absolute inset-0 z-0">
            <img
                src="/images/hero1.jpeg"
                alt="Contacto LOBIA"
                class="w-full h-full object-cover opacity-40 mix-blend-luminosity transform scale-105"
            />
            <div
                class="absolute inset-0 bg-gradient-to-b from-black/90 via-black/60 to-black"
            >
            </div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
            <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 mb-6 backdrop-blur-md">
                <div class="w-1.5 h-1.5 rounded-full bg-slate-300 animate-pulse"></div>
                <span class="text-gray-300 font-bold uppercase tracking-[0.2em] text-[10px] font-sans">Soporte y Ventas</span>
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl uppercase fuente-titulos">
                Contacto
            </h1>
            <p class="mt-4 max-w-xl mx-auto text-base text-gray-300 font-medium leading-relaxed font-sans">
                Estamos aquí para responder tus consultas y ayudarte a integrar la tecnología en tus operaciones diarias.
            </p>
        </div>
    </div>

    <!-- Main Content -->
    <!-- Fondo gris muy sutil para hacer que la tarjeta blanca del formulario resalte -->
    <main class="py-16 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-8 items-start">
                
                <!-- Info Column -->
                <div class="lg:col-span-2 space-y-8 lg:pr-8">
                    <div>
                        <h2 class="text-2xl font-extrabold text-brand-primary tracking-tight fuente-titulos">
                            Hablemos de tu negocio
                        </h2>
                        <p class="mt-4 text-base text-brand-secondary leading-relaxed font-sans">
                            Contáctanos a través de nuestros canales directos. Nuestro equipo está listo para brindarte la mejor solución.
                        </p>
                    </div>

                    <div class="space-y-4 font-sans">
                        <!-- Card WhatsApp -->
                        <div class="p-6 bg-white rounded-2xl border border-gray-100 shadow-sm flex items-center space-x-5 transition-transform hover:-translate-y-1 duration-300">
                            <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-brand-primary/5 text-brand-primary">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-brand-primary uppercase tracking-wider fuente-titulos">Llamadas y WhatsApp</h3>
                                <p class="mt-1 text-brand-secondary font-medium">+51 977 701 075</p>
                            </div>
                        </div>

                        <!-- Card Correo -->
                        <div class="p-6 bg-white rounded-2xl border border-gray-100 shadow-sm flex items-center space-x-5 transition-transform hover:-translate-y-1 duration-300">
                            <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-brand-primary/5 text-brand-primary">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v10a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-brand-primary uppercase tracking-wider fuente-titulos">Correo Electrónico</h3>
                                <p class="mt-1 text-brand-secondary font-medium text-sm">stefano13soto@gmail.com</p>
                            </div>
                        </div>

                        <!-- Card Ubicación -->
                        <div class="p-6 bg-white rounded-2xl border border-gray-100 shadow-sm flex items-center space-x-5 transition-transform hover:-translate-y-1 duration-300">
                            <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-brand-primary/5 text-brand-primary">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-brand-primary uppercase tracking-wider fuente-titulos">Sede Administrativa</h3>
                                <p class="mt-1 text-brand-secondary font-medium">Huancayo, Junín</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Form Section -->
                <div class="lg:col-span-3">
                    <form
                        action="#"
                        method="POST"
                        id="contacto-form"
                        class="bg-white p-8 sm:p-12 rounded-[2rem] border border-gray-100 shadow-2xl shadow-brand-primary/5 relative overflow-hidden"
                    >
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div>
                                <label for="first-name" class="block text-sm font-bold text-brand-primary uppercase tracking-wider mb-2 fuente-titulos">Nombres</label>
                                <input
                                    type="text"
                                    name="first-name"
                                    id="first-name"
                                    required
                                    class="block w-full rounded-xl border border-gray-200 bg-slate-50 px-4 py-4 text-base focus:border-brand-primary focus:bg-white focus:ring-1 focus:ring-brand-primary transition-colors outline-none font-sans"
                                    placeholder="Ej. Juan"
                                />
                            </div>
                            <div>
                                <label for="last-name" class="block text-sm font-bold text-brand-primary uppercase tracking-wider mb-2 fuente-titulos">Apellidos</label>
                                <input
                                    type="text"
                                    name="last-name"
                                    id="last-name"
                                    required
                                    class="block w-full rounded-xl border border-gray-200 bg-slate-50 px-4 py-4 text-base focus:border-brand-primary focus:bg-white focus:ring-1 focus:ring-brand-primary transition-colors outline-none font-sans"
                                    placeholder="Ej. Pérez"
                                />
                            </div>
                        </div>
                        
                        <div class="mb-6">
                            <label for="email" class="block text-sm font-bold text-brand-primary uppercase tracking-wider mb-2 fuente-titulos">Correo Electrónico</label>
                            <input
                                type="email"
                                name="email"
                                id="email"
                                required
                                class="block w-full rounded-xl border border-gray-200 bg-slate-50 px-4 py-4 text-base focus:border-brand-primary focus:bg-white focus:ring-1 focus:ring-brand-primary transition-colors outline-none font-sans"
                                placeholder="tu@correo.com"
                            />
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div>
                                <label for="phone" class="block text-sm font-bold text-brand-primary uppercase tracking-wider mb-2 fuente-titulos">Teléfono</label>
                                <input
                                    type="text"
                                    name="phone"
                                    id="phone"
                                    class="block w-full rounded-xl border border-gray-200 bg-slate-50 px-4 py-4 text-base focus:border-brand-primary focus:bg-white focus:ring-1 focus:ring-brand-primary transition-colors outline-none font-sans"
                                    placeholder="+51 999 999 999"
                                />
                            </div>
                            <div>
                                <label for="subject" class="block text-sm font-bold text-brand-primary uppercase tracking-wider mb-2 fuente-titulos">Asunto</label>
                                <input
                                    type="text"
                                    name="subject"
                                    id="subject"
                                    required
                                    class="block w-full rounded-xl border border-gray-200 bg-slate-50 px-4 py-4 text-base focus:border-brand-primary focus:bg-white focus:ring-1 focus:ring-brand-primary transition-colors outline-none font-sans"
                                    placeholder="Consulta general"
                                />
                            </div>
                        </div>
                        
                        <div class="mb-8">
                            <label for="message" class="block text-sm font-bold text-brand-primary uppercase tracking-wider mb-2 fuente-titulos">Mensaje</label>
                            <textarea
                                id="message"
                                name="message"
                                rows="5"
                                required
                                class="block w-full rounded-xl border border-gray-200 bg-slate-50 px-4 py-4 text-base focus:border-brand-primary focus:bg-white focus:ring-1 focus:ring-brand-primary transition-colors outline-none resize-none font-sans"
                                placeholder="¿En qué podemos ayudarte?"
                            ></textarea>
                        </div>
                        
                        <div>
                            <button
                                type="submit"
                                id="submit-btn"
                                class="w-full inline-flex justify-center items-center py-4 px-6 rounded-xl text-base font-bold text-white bg-brand-primary hover:bg-brand-primary/90 transition-all duration-300 transform hover:-translate-y-1 active:scale-95 tracking-widest uppercase shadow-lg fuente-titulos"
                            >
                                Enviar Mensaje
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <!-- Script de envío asíncrono -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('contacto-form');
            const submitBtn = document.getElementById('submit-btn');

            if (form instanceof HTMLFormElement && submitBtn instanceof HTMLButtonElement) {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    
                    const originalText = submitBtn.innerText;
                    submitBtn.innerText = 'ENVIANDO...';
                    submitBtn.disabled = true;

                    const formData = new FormData(form);
                    const data = Object.fromEntries(formData.entries());

                    try {
                        const response = await fetch('/api/contacto', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data),
                        });

                        if (response.ok) {
                            alert('¡Solicitud enviada con éxito! Nos pondremos en contacto pronto.');
                            form.reset();
                        } else {
                            alert('Hubo un error al enviar la solicitud.');
                        }
                    } catch (error) {
                        console.error(error);
                        alert('Error de conexión. Revisa tu internet.');
                    } finally {
                        submitBtn.innerText = originalText;
                        submitBtn.disabled = false;
                    }
                });
            }
        });
    </script>
</Layout>